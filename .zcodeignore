# ⚠️ نمط حرج: النسخ الاحتياطية تحوي APP_KEY وأسرارًا، ولا يغطيها أي سطر أعلاه.
# النشر يتم عبر FTP، فأي رفع كامل كان سينشر المفاتيح.
.env.bak*
.env.*.bak
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor

# قاعدة البيانات حالة تشغيلية (جلسات + طلبات تجريبية) لا تُحفظ في المستودع.
# النسخة الاحتياطية اليدوية تُحفظ في database/backups/ وهي مستثناة أيضًا.
/database/*.sqlite
/database/backups/

# مجلدات أدوات الذكاء الاصطناعي — ليست جزءًا من المشروع
/.kilo
/.mimosa
/.zcode
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# سكربت تهيئة النشر لمرة واحدة — يُحذف بعد الاستخدام
deploy-setup.php

.setup-token

